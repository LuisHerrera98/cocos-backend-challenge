{
  "info": {
    "name": "Cocos Backend Challenge",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "userId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Instruments",
      "item": [
        {
          "name": "Search by ticker",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/instruments?q=GGAL",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "instruments"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "GGAL"
                }
              ]
            },
            "description": "Exact ticker match is returned first."
          },
          "response": []
        },
        {
          "name": "Search by name",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/instruments?q=banco",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "instruments"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "banco"
                }
              ]
            },
            "description": "Case-insensitive match on the instrument name."
          },
          "response": []
        },
        {
          "name": "Search by partial text",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/instruments?q=ma",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "instruments"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "ma"
                }
              ]
            },
            "description": "Matches ticker or name containing the text."
          },
          "response": []
        },
        {
          "name": "Search with no results",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/instruments?q=zzz",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "instruments"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "zzz"
                }
              ]
            },
            "description": "Returns an empty array."
          },
          "response": []
        },
        {
          "name": "Invalid: empty query",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/instruments?q=",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "instruments"
              ],
              "query": [
                {
                  "key": "q",
                  "value": ""
                }
              ]
            },
            "description": "Returns 400 Bad Request."
          },
          "response": []
        },
        {
          "name": "Invalid: control character",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/instruments?q=%00",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "instruments"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "%00"
                }
              ]
            },
            "description": "Returns 400 Bad Request."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Portfolio",
      "item": [
        {
          "name": "Get portfolio",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/portfolio",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}",
                "portfolio"
              ]
            },
            "description": "Total account value, available cash and positions."
          },
          "response": []
        },
        {
          "name": "User without orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/2/portfolio",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "2",
                "portfolio"
              ]
            },
            "description": "Returns zero balances and no positions."
          },
          "response": []
        },
        {
          "name": "User not found",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/999/portfolio",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "999",
                "portfolio"
              ]
            },
            "description": "Returns 404 Not Found."
          },
          "response": []
        },
        {
          "name": "Invalid: non numeric id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/abc/portfolio",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "abc",
                "portfolio"
              ]
            },
            "description": "Returns 400 Bad Request."
          },
          "response": []
        }
      ]
    }
  ]
}